{
  "name": "core-language",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/language/src",
  "prefix": "amk",
  "tags": ["scope:core", "type:core"],
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["libs/core/language/src/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/core/language/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "angular-material_kit:build:development",
        "tsConfig": "libs/core/language/tsconfig.spec.json",
        "include": ["**/*.spec.ts", "**/*.test.ts"]
      }
    }
  }
}
