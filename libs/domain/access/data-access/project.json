{
  "name": "domain-access-data-access",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/access/data-access/src",
  "prefix": "amk",
  "tags": ["scope:domain", "type:data-access"],
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "libs/domain/access/data-access/src/**/*.ts",
          "libs/domain/access/data-access/src/**/*.html"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/domain/access/data-access/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "angular-material_kit:build:development",
        "tsConfig": "libs/domain/access/data-access/tsconfig.spec.json",
        "include": ["**/*.spec.ts", "**/*.test.ts"]
      }
    }
  }
}
