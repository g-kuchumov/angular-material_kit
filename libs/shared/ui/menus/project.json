{
  "name": "shared-ui-menus",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/menus/src",
  "prefix": "amk",
  "tags": ["scope:shared", "type:ui"],
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["libs/shared/ui/menus/src/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/shared/ui/menus/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "angular-material_kit:build:development",
        "tsConfig": "libs/shared/ui/menus/tsconfig.spec.json",
        "include": ["**/*.spec.ts", "**/*.test.ts"]
      }
    }
  }
}
